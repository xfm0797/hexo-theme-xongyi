<%#
  合并板块：左侧「关于我们」+ 右侧「联系我们」
  数据来源：theme.about / theme.contact（与独立板块共用同一份配置）
%>
<section class="section section--tint about-contact" id="about-contact">
  <div class="container about-contact__grid">
    <%# ---- 左：关于我们 ---- %>
    <div class="about-contact__col reveal">
      <div class="section-head section-head--left">
        <h2><%= theme.about.title %></h2>
        <% if (theme.about.subtitle) { %><p><%= theme.about.subtitle %></p><% } %>
      </div>
      <% if (theme.about.image) { %>
      <img class="about-contact__image" src="<%- url_for(theme.about.image) %>" alt="<%= theme.about.title %>" loading="lazy">
      <% } %>
      <div class="about__text"><%- theme.about.content %></div>
      <% if (theme.about.link && theme.about.link.name) { %>
      <a class="btn btn--primary" href="<%- url_for(theme.about.link.url) %>"><%= theme.about.link.name %><%- icon('arrow-right') %></a>
      <% } %>
    </div>

    <%# ---- 右：联系我们 ---- %>
    <div class="about-contact__col reveal">
      <div class="section-head section-head--left">
        <h2><%= theme.contact.title %></h2>
        <% if (theme.contact.subtitle) { %><p><%= theme.contact.subtitle %></p><% } %>
      </div>
      <%- partial('_partial/contact-info') %>
      <% if (theme.contact.form_action) { %>
      <%- partial('_partial/contact-form') %>
      <% } %>
    </div>
  </div>
</section>
