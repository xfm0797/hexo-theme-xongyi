<section class="section" id="contact">
  <div class="container">
    <div class="section-head reveal">
      <h2><%= theme.contact.title %></h2>
      <% if (theme.contact.subtitle) { %><p><%= theme.contact.subtitle %></p><% } %>
    </div>
    <div class="contact__grid">
      <div class="contact__info reveal">
        <% if (theme.contact.address) { %>
        <div class="contact-item"><span class="contact-item__icon"><%- icon('map-pin') %></span><div><h4><%= __('address') %></h4><p><%= theme.contact.address %></p></div></div>
        <% } %>
        <% if (theme.contact.phone) { %>
        <div class="contact-item"><span class="contact-item__icon"><%- icon('phone') %></span><div><h4><%= __('phone') %></h4><p><a href="tel:<%= theme.contact.phone.replace(/\s/g, '') %>"><%= theme.contact.phone %></a></p></div></div>
        <% } %>
        <% if (theme.contact.email) { %>
        <div class="contact-item"><span class="contact-item__icon"><%- icon('mail') %></span><div><h4><%= __('email') %></h4><p><a href="mailto:<%= theme.contact.email %>"><%= theme.contact.email %></a></p></div></div>
        <% } %>
        <% if (theme.contact.hours) { %>
        <div class="contact-item"><span class="contact-item__icon"><%- icon('clock') %></span><div><h4><%= __('work_hours') %></h4><p><%= theme.contact.hours %></p></div></div>
        <% } %>
        <% if (theme.contact.wechat) { %>
        <div class="contact-item"><span class="contact-item__icon"><%- icon('message-circle') %></span><div><h4><%= __('wechat') %></h4><p><img class="contact-qrcode" src="<%- url_for(theme.contact.wechat) %>" alt="<%= __('wechat') %>"></p></div></div>
        <% } %>
      </div>
      <% if (theme.contact.form_action) { %>
      <form class="contact-form reveal" action="<%- theme.contact.form_action %>" method="POST">
        <div class="form-row">
          <label for="cf-name"><%= __('your_name') %></label>
          <input id="cf-name" type="text" name="name" required>
        </div>
        <div class="form-row">
          <label for="cf-email"><%= __('your_email') %></label>
          <input id="cf-email" type="email" name="email" required>
        </div>
        <div class="form-row">
          <label for="cf-message"><%= __('your_message') %></label>
          <textarea id="cf-message" name="message" rows="4" required></textarea>
        </div>
        <button class="btn btn--primary" type="submit"><%= __('send') %><%- icon('send') %></button>
      </form>
      <% } %>
    </div>
    <% if (theme.contact.map) { %>
    <div class="contact-map reveal">
      <iframe src="<%- theme.contact.map %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="map"></iframe>
    </div>
    <% } %>
  </div>
</section>
