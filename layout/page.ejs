<article class="page">
  <section class="page-hero">
    <div class="container">
      <h1><%= page.title %></h1>
      <% if (page.subtitle) { %><p class="page-hero__subtitle"><%= page.subtitle %></p><% } %>
    </div>
  </section>
  <div class="container page-content reveal">
    <%- page.content %>
  </div>
</article>
