<section class="section" id="contact">
  <div class="container">
    <div class="section-head reveal">
      <h2><%= theme.contact.title %></h2>
      <% if (theme.contact.subtitle) { %><p><%= theme.contact.subtitle %></p><% } %>
    </div>
    <div class="contact__grid<% if (!theme.contact.form_action) { %> contact__grid--single<% } %>">
      <%- partial('_partial/contact-info') %>
      <% if (theme.contact.form_action) { %>
      <%- partial('_partial/contact-form') %>
      <% } %>
    </div>
    <% if (theme.contact.map) { %>
    <div class="contact-map reveal">
      <iframe src="<%- theme.contact.map %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="map"></iframe>
    </div>
    <% } %>
  </div>
</section>
