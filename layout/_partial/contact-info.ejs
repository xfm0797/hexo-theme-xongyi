<%# 联系信息列表（供「联系我们」板块与「关于我们+联系我们」合并板块复用） %>
<div class="contact__info">
  <% if (theme.contact.address) { %>
  <div class="contact-item"><span class="contact-item__icon"><%- icon('map-pin') %></span><div><h4><%= __('address') %></h4><p><%= theme.contact.address %></p></div></div>
  <% } %>
  <% if (theme.contact.phone) { %>
  <div class="contact-item"><span class="contact-item__icon"><%- icon('phone') %></span><div><h4><%= __('phone') %></h4><p><a href="tel:<%= theme.contact.phone.replace(/\s/g, '') %>"><%= theme.contact.phone %></a></p></div></div>
  <% } %>
  <% if (theme.contact.email) { %>
  <div class="contact-item"><span class="contact-item__icon"><%- icon('mail') %></span><div><h4><%= __('email') %></h4><p><a href="mailto:<%= theme.contact.email %>"><%= theme.contact.email %></a></p></div></div>
  <% } %>
  <% if (theme.contact.hours) { %>
  <div class="contact-item"><span class="contact-item__icon"><%- icon('clock') %></span><div><h4><%= __('work_hours') %></h4><p><%= theme.contact.hours %></p></div></div>
  <% } %>
  <% if (theme.contact.wechat) { %>
  <div class="contact-item"><span class="contact-item__icon"><%- icon('message-circle') %></span><div><h4><%= __('wechat') %></h4><p><img class="contact-qrcode" src="<%- url_for(theme.contact.wechat) %>" alt="<%= __('wechat') %>"></p></div></div>
  <% } %>
</div>
